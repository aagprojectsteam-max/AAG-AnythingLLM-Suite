# Copy to ~/.config/aag-anythingllm/config.env and adjust. Never commit that file.
# Empty integration paths are auto-detected where possible.
AAG_PROFILE=full
AAG_INSTALL_ROOT=$HOME/.local/share/aag-anythingllm-suite
AAG_STATE_ROOT=$HOME/.local/state/aag-anythingllm-suite
AAG_CONFIG_ROOT=$HOME/.config/aag-anythingllm-suite
AAG_OUTPUT_ROOT=$HOME/.local/share/aag-anythingllm-suite/outputs
AAG_ATLAS_ROOT=$HOME/.local/share/aag-anythingllm-suite/visual-atlas
AAG_MODEL_ROOT=$HOME/.local/share/aag-models
ANYTHINGLLM_ROOT=
ANYTHINGLLM_STORAGE=
COMFYUI_ROOT=
LLAMACPP_ROOT=
STOCKFISH_BIN=
AAG_IMAGE_HUB_PORT=18190
AAG_UPSCALE_PORT=18191
AAG_COMFYUI_BRIDGE_PORT=18188
AAG_COMPATIBILITY_PORT=18192
# AAG_COMPATIBILITY_TOKEN_FILE=$HOME/.config/aag-anythingllm/compatibility-token
