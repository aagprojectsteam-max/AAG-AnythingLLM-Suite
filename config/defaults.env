# Central AAG Suite configuration. Values may be overridden in ~/.config/aag-anythingllm/config.env.
AAG_SUITE_VERSION=${AAG_SUITE_VERSION:-1.0.0-rc1}
AAG_PROFILE=${AAG_PROFILE:-full}
AAG_INSTALL_ROOT=${AAG_INSTALL_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/aag-anythingllm-suite}
AAG_STATE_ROOT=${AAG_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/aag-anythingllm-suite}
AAG_CONFIG_ROOT=${AAG_CONFIG_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/aag-anythingllm-suite}
AAG_OUTPUT_ROOT=${AAG_OUTPUT_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/aag-anythingllm-suite/outputs}
AAG_ATLAS_ROOT=${AAG_ATLAS_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/aag-anythingllm-suite/visual-atlas}
AAG_MODEL_ROOT=${AAG_MODEL_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/aag-models}
AAG_IMAGE_HUB_PORT=${AAG_IMAGE_HUB_PORT:-18190}
AAG_UPSCALE_PORT=${AAG_UPSCALE_PORT:-18191}
AAG_COMFYUI_BRIDGE_PORT=${AAG_COMFYUI_BRIDGE_PORT:-18188}
AAG_IMAGE_PROXY_PORT=${AAG_IMAGE_PROXY_PORT:-18189}
AAG_COMPATIBILITY_PORT=${AAG_COMPATIBILITY_PORT:-18192}
AAG_ENABLE_SYSTEMD=${AAG_ENABLE_SYSTEMD:-auto}
AAG_INSTALL_OS_PACKAGES=${AAG_INSTALL_OS_PACKAGES:-0}
ANYTHINGLLM_ROOT=${ANYTHINGLLM_ROOT:-}
ANYTHINGLLM_STORAGE=${ANYTHINGLLM_STORAGE:-}
COMFYUI_ROOT=${COMFYUI_ROOT:-}
LLAMACPP_ROOT=${LLAMACPP_ROOT:-}
STOCKFISH_BIN=${STOCKFISH_BIN:-}
LOCAL_LLM_BACKEND=${LOCAL_LLM_BACKEND:-auto}
