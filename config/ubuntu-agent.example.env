# The Ubuntu Agent is not installed by this suite. These names document the
# non-secret boundary for a future separately released portable component.
AAG_UBUNTU_AGENT_BIND=127.0.0.1
AAG_UBUNTU_AGENT_PORT=18193
AAG_UBUNTU_AGENT_STATE_ROOT=${XDG_STATE_HOME:-$HOME/.local/state}/aag-ubuntu-agent
AAG_UBUNTU_AGENT_CONFIG_ROOT=${XDG_CONFIG_HOME:-$HOME/.config}/aag-ubuntu-agent
AAG_UBUNTU_AGENT_ENABLE_REMEDIATION=0
