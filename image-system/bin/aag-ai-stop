#!/usr/bin/env bash
set -Eeuo pipefail

COMFY_DIR="/mnt/data/AI/ComfyUI"
BRIDGE="aag-comfyui-docker-bridge.service"
PROXY="aag-comfyui-image-proxy.service"

echo "============================================================"
echo " AAG AI — CONTROLLED SHUTDOWN"
echo " Graceful shutdown only"
echo "============================================================"

find_comfy_pids() {
    local pid cwd cmd

    for pid in $(pgrep -f 'python.*main\.py' 2>/dev/null || true); do
        [[ -d "/proc/$pid" ]] || continue

        cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
        cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"

        if [[ "$cwd" == "$COMFY_DIR" ]] &&
           [[ "$cmd" == *"main.py"* ]] &&
           [[ "$cmd" == *"--port 8188"* ]]; then
            printf '%s\n' "$pid"
        fi
    done
}

mapfile -t PIDS < <(find_comfy_pids)

if ((${#PIDS[@]})); then
    echo
    echo "[1/4] ComfyUI found:"
    for pid in "${PIDS[@]}"; do
        printf 'PID %s: ' "$pid"
        tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true
        echo
    done

    echo
    echo "[2/4] Requesting normal ComfyUI shutdown (SIGTERM)..."

    for pid in "${PIDS[@]}"; do
        kill -TERM "$pid"
    done

    echo "Waiting for ComfyUI to finish cleanly..."

    CLEAN=0

    for ((i=1; i<=30; i++)); do
        STILL_RUNNING=0

        for pid in "${PIDS[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                STILL_RUNNING=1
                break
            fi
        done

        if (( STILL_RUNNING == 0 )); then
            CLEAN=1
            break
        fi

        sleep 1
    done

    if (( CLEAN == 0 )); then
        echo
        echo "============================================================"
        echo " WARNING"
        echo " ComfyUI did not finish within 30 seconds after SIGTERM."
        echo
        echo " NOTHING WILL BE FORCE-KILLED."
        echo " Support services will remain untouched."
        echo " Check the ComfyUI terminal for an active job or error."
        echo "============================================================"
        exit 1
    fi

    echo "ComfyUI exited cleanly."

else
    echo
    echo "[1/4] ComfyUI is already stopped."
    echo "[2/4] No ComfyUI process needs shutdown."
fi

echo
echo "[3/4] Stopping support services gracefully..."

systemctl --user stop "$PROXY" 2>/dev/null || true
systemctl --user stop "$BRIDGE" 2>/dev/null || true

echo
echo "[4/4] Final verification..."

mapfile -t LEFT < <(find_comfy_pids)

echo
echo "ComfyUI:"
if ((${#LEFT[@]} == 0)); then
    echo "  inactive"
else
    echo "  STILL RUNNING: ${LEFT[*]}"
fi

echo
echo "Docker bridge:"
echo "  $(systemctl --user is-active "$BRIDGE" 2>/dev/null || true)"

echo
echo "Image proxy:"
echo "  $(systemctl --user is-active "$PROXY" 2>/dev/null || true)"

echo
echo "Network watchdog timer:"
echo "  $(systemctl is-active aag-anythingllm-comfyui-network-watch.timer 2>/dev/null || true)"

if ((${#LEFT[@]} == 0)) &&
   ! systemctl --user is-active --quiet "$BRIDGE" &&
   ! systemctl --user is-active --quiet "$PROXY"; then

    echo
    echo "============================================================"
    echo " SAFE SHUTDOWN COMPLETE"
    echo " ComfyUI      : OFF"
    echo " Image proxy  : OFF"
    echo " Docker bridge: OFF"
    echo " No force-kill was used."
    echo "============================================================"
else
    echo
    echo "WARNING: shutdown verification was not fully clean."
    exit 1
fi
