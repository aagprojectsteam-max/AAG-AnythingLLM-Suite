          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "RECORDED"
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "UNKNOWN",
                "NOT_RECORDED",
                "NOT_APPLICABLE"
              ]
            }
          }
        }
      ]
    }
